# HuggingFace API token (free at https://huggingface.co/settings/tokens)
# Optional: enables higher-quality embedding-based graph on startup.
# Without it, a metadata-based graph is built instead (still works fine).
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database URL — SQLite for local dev, PostgreSQL (Neon) for production
# Local: sqlite+aiosqlite:///./data/gravenger.db
# Neon:  postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./data/gravenger.db
